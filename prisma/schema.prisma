generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  projects  Project[]
}

model Project {
  id          String     @id @default(cuid())
  title       String
  description String
  clientId    String
  freelancer  String
  budget      String
  asset       String
  status      String
  startDate   DateTime
  endDate     DateTime
  milestones  Milestone[]
  escrow      Escrow?
  client      User       @relation(fields: [clientId], references: [id])
  createdAt   DateTime   @default(now())
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String
  amount      String
  dueDate     DateTime
  status      String
  project     Project   @relation(fields: [projectId], references: [id])
  escrow      Escrow?
}

model Escrow {
  id          String    @id @default(cuid())
  projectId   String    @unique
  milestoneId String?   @unique
  amount      String
  asset       String
  status      String
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id])
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  hash        String   @unique
  amount      String
  asset       String
  sender      String
  recipient   String
  status      String
  timestamp   DateTime
  network     String
  explorerUrl String?
  createdAt   DateTime @default(now())
}

model Dispute {
  id          String   @id @default(cuid())
  projectId   String
  milestoneId String?
  reason      String
  status      String
  createdAt   DateTime @default(now())
}

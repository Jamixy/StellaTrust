{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@stellar-trust/types": ["packages/types/src/index.ts"],
      "@stellar-trust/validation": ["packages/validation/src/index.ts"],
      "@stellar-trust/stellar": ["packages/stellar/src/index.ts"]
    }
  },
  "include": ["apps", "packages"]
}
